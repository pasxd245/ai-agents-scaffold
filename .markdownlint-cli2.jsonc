{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD029": { "style": "ordered" },
    "MD036": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "CHANGELOG.md",
    // Rendered templates contain Handlebars, which is not valid markdown.
    // Pool skills under templates/skills/ are plain .md and copied verbatim,
    // so they are linted like anything else — link rot in a published skill
    // reaches every repo that installs it.
    "templates/scaffold/**",
    ".claude/**",
    ".codex/**",
    ".gemini/**",
    ".github/skills/**",
    ".agents/plan/cycles/**",
    ".agents/prompts/**",
    ".agents/tmp/**",
    "tests/fixtures/**",
    "tmp/**",
  ],
}
